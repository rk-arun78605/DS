@st.cache_data(ttl=600)
def load_funnel_data(start_date, end_date):
    """Load funnel data with all stages"""
    query = """
    WITH base_data AS (
        SELECT 
            serial_no,
            vc_shop_code AS dest_shop,
            shop_sold,
            vc_serail_no AS shop_serial_no,
            dt_doc_date,
            loaded_datetime,
            dt_wod_date,
            dt_invoice_date,
            vc_item_code,
            vc_item_desc,
            vc_warehouse_desc,
            vc_wh_code,
            shop_name,
            nu_selling_price,
            CASE 
                WHEN dt_invoice_date IS NOT NULL THEN 'Sold'
                WHEN dt_wod_date IS NOT NULL THEN 'Offloaded'
                WHEN loaded_datetime IS NOT NULL THEN 'Loaded'
                ELSE 'Unknown'
            END as status,
            CASE 
                WHEN shop_sold IS NOT NULL 
                AND vc_shop_code IS NOT NULL 
                AND shop_sold != vc_shop_code 
                THEN 1 
                ELSE 0 
            END as is_mismatch
        FROM serial_no_tracking
        WHERE dt_doc_date BETWEEN %s AND %s
    )
    SELECT * FROM base_data
    """
    
    with get_db_connection() as conn:
        df = pd.read_sql_query(query, conn, params=(start_date, end_date))
    
    return df

@st.cache_data(ttl=600)
def load_shop_funnel_data(start_date, end_date):
    """Load shop-wise funnel breakdown"""
    query = """
    SELECT 
        vc_shop_code AS shop_code,
        shop_name,
        COUNT(DISTINCT serial_no) as total_loaded,
        COUNT(DISTINCT CASE WHEN dt_wod_date IS NOT NULL THEN serial_no END) as total_offloaded,
        COUNT(DISTINCT CASE WHEN dt_invoice_date IS NOT NULL THEN serial_no END) as total_sold,
        COUNT(DISTINCT CASE 
            WHEN shop_sold IS NOT NULL 
            AND vc_shop_code IS NOT NULL 
            AND shop_sold != vc_shop_code 
            THEN serial_no 
        END) as total_mismatch
    FROM serial_no_tracking
    WHERE dt_doc_date BETWEEN %s AND %s
    GROUP BY vc_shop_code, shop_name
    ORDER BY total_loaded DESC
    """
    
    with get_db_connection() as conn:
        df = pd.read_sql_query(query, conn, params=(start_date, end_date))
    
    return df

