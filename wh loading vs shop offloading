@st.cache_data(ttl=600)
def load_mismatch_details(start_date, end_date):
    """Load detailed mismatch records with scenario classification"""
    query = """
    SELECT 
        serial_no,
        vc_serail_no,
        shop_serail_no,
        vc_shop_code AS dest_shop,
        shop_sold,
        shop_name AS dest_shop_name,
        vc_item_desc,
        dt_doc_date,
        dt_invoice_date,
        dt_wod_date,
        nu_selling_price,
        vc_warehouse_desc,
        vc_vehicle_no,
        CASE 
            -- Scenario 1: Perfect Match (shop codes match AND all serials match)
            WHEN vc_shop_code = shop_sold 
                 AND serial_no = vc_serail_no 
                 AND serial_no = shop_serail_no 
                 THEN '✅ No Issue'
            
            -- Scenario 2: Sold at Different Shop (sold but wrong shop)
            WHEN shop_sold IS NOT NULL 
                 AND vc_shop_code != shop_sold 
                 THEN '🔄 Sold at Different Shop'
            
            -- Scenario 3: Shop Didnt Offload (no offload or sale record)
            WHEN shop_sold IS NULL 
                 OR vc_serail_no IS NULL 
                 OR shop_serail_no IS NULL 
                 THEN '⚠️ Shop Didnt Offload'
            
            -- Scenario 4: Serial Mismatch (right shop but wrong serials)
            WHEN vc_shop_code = shop_sold 
                 AND (serial_no != vc_serail_no OR serial_no != shop_serail_no)
                 THEN '🔢 Serial Number Mismatch'
            
            ELSE '❓ Unknown'
        END as mismatch_scenario
    FROM serial_no_tracking
    WHERE dt_doc_date BETWEEN %s AND %s
        AND (
            -- Include all scenarios
            (vc_shop_code != shop_sold) OR
            (shop_sold IS NULL OR vc_serail_no IS NULL OR shop_serail_no IS NULL) OR
            (serial_no != vc_serail_no OR serial_no != shop_serail_no)
        )
    ORDER BY dt_invoice_date DESC NULLS LAST
    """
    
    with get_db_connection() as conn:
        df = pd.read_sql_query(query, conn, params=(start_date, end_date))
    
    return df

