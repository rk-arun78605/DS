def create_mismatch_sankey(mismatch_data):
    """Create Sankey diagram showing flow from destination to actual sold shop"""
    
    # Filter only 'Sold at Different Shop' scenario for Sankey
    sankey_data = mismatch_data[mismatch_data['mismatch_scenario'] == '🔄 Sold at Different Shop'].copy()
    
    if len(sankey_data) == 0:
        # Return empty figure with message
        fig = go.Figure()
        fig.add_annotation(
            text="No 'Sold at Different Shop' scenarios found in selected date range",
            xref="paper", yref="paper",
            x=0.5, y=0.5, showarrow=False,
            font=dict(size=16, color="#7f8c8d")
        )
        fig.update_layout(height=400)
        return fig
    
    # Get top 15 mismatch patterns
    flow_data = sankey_data.groupby(['dest_shop', 'shop_sold']).agg({
        'serial_no': 'count',
        'nu_selling_price': 'sum'
    }).reset_index().nlargest(15, 'serial_no')
    
    # Create unique node list
    dest_shops = flow_data['dest_shop'].unique().tolist()
    sold_shops = flow_data['shop_sold'].unique().tolist()
    all_nodes = list(set(dest_shops + sold_shops))
    
    # Create node indices
    node_dict = {node: idx for idx, node in enumerate(all_nodes)}
    
    # Create source, target, value lists
    sources = [node_dict[dest] for dest in flow_data['dest_shop']]
    targets = [node_dict[sold] for sold in flow_data['shop_sold']]
    values = flow_data['serial_no'].tolist()
    
    # Create labels with counts
    node_labels = []
    for node in all_nodes:
        dest_count = flow_data[flow_data['dest_shop'] == node]['serial_no'].sum()
        sold_count = flow_data[flow_data['shop_sold'] == node]['serial_no'].sum()
        total = dest_count + sold_count
        node_labels.append(f"{node}<br>({int(total)})")
    
    # Create colors
    node_colors = ['rgba(255, 127, 14, 0.8)' if i < len(dest_shops) else 'rgba(44, 160, 44, 0.8)' 
                   for i in range(len(all_nodes))]
    
    link_colors = ['rgba(255, 0, 0, 0.3)' for _ in range(len(sources))]
    
    fig = go.Figure(go.Sankey(
        node=dict(
            pad=15,
            thickness=20,
            line=dict(color='white', width=2),
            label=node_labels,
            color=node_colors,
            hovertemplate='%{label}<br>Total Flow: %{value}<extra></extra>'
        ),
        link=dict(
            source=sources,
            target=targets,
            value=values,
            color=link_colors,
            hovertemplate='%{source.label} → %{target.label}<br>Count: %{value}<extra></extra>'
        )
    ))
    
    fig.update_layout(
        title={
            'text': '🔄 Mismatch Flow - Destination → Actual Sold Shop',
            'font': {'size': 20, 'color': '#2c3e50', 'family': 'Arial Black'},
            'x': 0.5,
            'xanchor': 'center'
        },
        height=600,
        paper_bgcolor='rgba(0,0,0,0)',
        font={'size': 12, 'color': '#2c3e50'},
        margin=dict(l=20, r=20, t=80, b=20)
    )
    
    return fig

