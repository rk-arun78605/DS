def create_mismatch_sunburst(mismatch_data):
    """Create interactive sunburst chart for hierarchical mismatch analysis"""
    
    # Prepare hierarchical data: Destination Shop -> Shop Sold -> Group -> Serial Numbers
    sunburst_prep = mismatch_data.copy()
    
    # Extract group from description (first word/brand)
    sunburst_prep['group'] = sunburst_prep['vc_item_desc'].str.split(' |-|_').str[0].str.upper()
    
    # Create hierarchy dataframe
    hierarchy_data = []
    
    # Level 1: Destination Shop (where it should have gone)
    dest_agg = sunburst_prep.groupby('dest_shop').agg({
        'serial_no': 'count',
        'nu_selling_price': 'sum'
    }).reset_index()
    
    for _, row in dest_agg.iterrows():
        hierarchy_data.append({
            'labels': f"📍 {row['dest_shop']}",
            'parents': 'Mismatch Root',
            'values': row['serial_no'],
            'text': f"Dest Shop: {row['dest_shop']}<br>Count: {row['serial_no']}<br>Value: ₵{row['nu_selling_price']:,.2f}"
        })
    
    # Level 2: Shop Sold (where it actually went) under destination
    sold_agg = sunburst_prep.groupby(['dest_shop', 'shop_sold']).agg({
        'serial_no': 'count',
        'nu_selling_price': 'sum'
    }).reset_index()
    
    for _, row in sold_agg.iterrows():
        hierarchy_data.append({
            'labels': f"🏪 {row['shop_sold']}",
            'parents': f"📍 {row['dest_shop']}",
            'values': row['serial_no'],
            'text': f"Actually Sold at: {row['shop_sold']}<br>Count: {row['serial_no']}<br>Value: ₵{row['nu_selling_price']:,.2f}"
        })
    
    # Level 3: Group under sold shop
    group_agg = sunburst_prep.groupby(['dest_shop', 'shop_sold', 'group']).agg({
        'serial_no': 'count',
        'nu_selling_price': 'sum'
    }).reset_index()
    
    for _, row in group_agg.iterrows():
        hierarchy_data.append({
            'labels': f"📦 {row['group']}",
            'parents': f"🏪 {row['shop_sold']}",
            'values': row['serial_no'],
            'text': f"Group: {row['group']}<br>Count: {row['serial_no']}<br>Value: ₵{row['nu_selling_price']:,.2f}"
        })
    
    # Level 4: Individual serial numbers under group (limit to top 100 per group for performance)
    for _, row in sunburst_prep.iterrows():
        # Only add if less than 100 serials per group to avoid overcrowding
        group_count = sunburst_prep[
            (sunburst_prep['dest_shop'] == row['dest_shop']) & 
            (sunburst_prep['shop_sold'] == row['shop_sold']) & 
            (sunburst_prep['group'] == row['group'])
        ].shape[0]
        
        if group_count <= 50:  # Only show individual serials for smaller groups
            hierarchy_data.append({
                'labels': f"🔢 {str(row['serial_no'])[:15]}",
                'parents': f"📦 {row['group']}",
                'values': 1,
                'text': f"Serial: {row['serial_no']}<br>Item: {row['vc_item_desc'][:30]}<br>Price: ₵{row['nu_selling_price']:,.2f}"
            })
    
    # Add root
    total_count = mismatch_data['serial_no'].count()
    total_value = mismatch_data['nu_selling_price'].sum()
    hierarchy_data.insert(0, {
        'labels': 'Mismatch Root',
        'parents': '',
        'values': total_count,
        'text': f"Total: {total_count}<br>Value: ₵{total_value:,.2f}"
    })
    
    df_hierarchy = pd.DataFrame(hierarchy_data)
    
    # Create sunburst
    fig = go.Figure(go.Sunburst(
        labels=df_hierarchy['labels'],
        parents=df_hierarchy['parents'],
        values=df_hierarchy['values'],
        text=df_hierarchy['text'],
        hovertemplate='<b>%{label}</b><br>%{text}<extra></extra>',
        marker=dict(
            colorscale='RdYlBu_r',
            cmid=df_hierarchy['values'].median() if len(df_hierarchy) > 0 else 1,
            line=dict(color='white', width=2)
        ),
        branchvalues='total'
    ))
    
    fig.update_layout(
        title={
            'text': '🌞 Mismatch Hierarchy - Dest Shop → Actual Shop → Group → Serials',
            'font': {'size': 22, 'color': '#2c3e50', 'family': 'Arial Black'},
            'x': 0.5,
            'xanchor': 'center'
        },
        height=700,
        paper_bgcolor='rgba(0,0,0,0)',
        font={'size': 12, 'color': '#2c3e50'},
        margin=dict(l=0, r=0, t=80, b=0)
    )
    
    return fig

def create_scenario_breakdown_chart(mismatch_data):
    """Create breakdown chart by mismatch scenario"""
    
    # Count by scenario
    scenario_counts = mismatch_data['mismatch_scenario'].value_counts().reset_index()
    scenario_counts.columns = ['Scenario', 'Count']
    
    # Add value aggregation
    scenario_values = mismatch_data.groupby('mismatch_scenario')['nu_selling_price'].sum().reset_index()
    scenario_values.columns = ['Scenario', 'Total_Value']
    
    scenario_summary = scenario_counts.merge(scenario_values, on='Scenario')
    
    # Create color mapping
