def create_mismatch_heatmap(mismatch_data):
    """Create heatmap showing destination shop vs actual sold shop"""
    
    # Create crosstab
    heatmap_data = pd.crosstab(
        mismatch_data['dest_shop'], 
        mismatch_data['shop_sold'],
        values=mismatch_data['serial_no'],
        aggfunc='count',
        dropna=False
    ).fillna(0)
    
    fig = go.Figure(data=go.Heatmap(
        z=heatmap_data.values,
        x=heatmap_data.columns,
        y=heatmap_data.index,
        colorscale='Reds',
        text=heatmap_data.values,
        texttemplate='%{text}',
        textfont={"size": 12},
        colorbar=dict(title="Count")
    ))
    
    fig.update_layout(
        title={
