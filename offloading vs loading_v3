@st.cache_data(ttl=300)
def get_root_cause_patterns(start_date, end_date):
    """Identify patterns that indicate root causes of issues"""
    with get_db_connection() as conn:
        cursor = conn.cursor(cursor_factory=RealDictCursor)
        
        start_str = start_date.strftime('%Y-%m-%d') if hasattr(start_date, 'strftime') else str(start_date)
        end_str = end_date.strftime('%Y-%m-%d') if hasattr(end_date, 'strftime') else str(end_date)
        
        query = f"""
            SELECT 
                vc_shop_code,
                -- Process Issues
                SUM(CASE WHEN remarks2 LIKE '%Sold without offloading%' THEN 1 ELSE 0 END) as process_bypass,
                -- Data Entry Issues
                SUM(CASE WHEN remarks2 LIKE '%Serial mismatch%' THEN 1 ELSE 0 END) as data_entry_errors,
                -- Routing Issues
                SUM(CASE WHEN remarks2 LIKE '%Shop mismatch%' THEN 1 ELSE 0 END) as routing_errors,
                -- Vehicle Issues
                SUM(CASE WHEN vc_vehicle_no != vc_vehicle_no_2 
                    AND vc_vehicle_no IS NOT NULL 
                    AND vc_vehicle_no_2 IS NOT NULL 
                    THEN 1 ELSE 0 END) as vehicle_mismatches,
                -- Total Issues
                SUM(CASE WHEN remarks2 LIKE '⚠️%' THEN 1 ELSE 0 END) as total_issues
            FROM serial_no_dailydata
            WHERE loaded_datetime >= '{start_str}' AND loaded_datetime <= '{end_str}'
              AND vc_shop_code IS NOT NULL
            GROUP BY vc_shop_code
            HAVING SUM(CASE WHEN remarks2 LIKE '⚠️%' THEN 1 ELSE 0 END) > 0
            ORDER BY total_issues DESC
            LIMIT 15
        """
        
        cursor.execute(query)
        return pd.DataFrame(cursor.fetchall())

