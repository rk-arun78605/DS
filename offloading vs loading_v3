        query = f"""
            SELECT 
                vc_shop_code,
                brand,
                "group",
                serial_no,
                vc_vehicle_no as warehouse_vehicle,
                vc_vehicle_no_2 as shop_vehicle,
                loaded_datetime,
                remarks2
            FROM serial_no_dailydata
            WHERE loaded_datetime >= '{start_str}' AND loaded_datetime <= '{end_str}'
              AND vc_vehicle_no IS NOT NULL 
