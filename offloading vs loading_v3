@st.cache_resource
def get_connection_pool():
    return SimpleConnectionPool(
        minconn=1, maxconn=10,
        host='localhost', port=3307,
        user='postgres', password='hello', dbname='WH'
    )

@contextmanager
def get_db_connection():
    pool = get_connection_pool()
    conn = pool.getconn()
    try:
        yield conn
    finally:
        pool.putconn(conn)

