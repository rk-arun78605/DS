@st.cache_resource
def get_connection_pool():
    """Create connection pool"""
    return psycopg2.pool.SimpleConnectionPool(
        minconn=1,
        maxconn=5,
        **Config.DB_CONFIG
    )


@contextmanager
def get_db_connection():
    """Get connection from pool"""
    pool = get_connection_pool()
    conn = pool.getconn()
    try:
        yield conn
    finally:
        pool.putconn(conn)


